{#
/**
 * @file
 * Theme override for a TripalEntity add/edit form.
 *
 * Two column template matching the node add/edit form.
 *
 * Available variables:
 * - form: The TripalEntity add/edit form.
 */
#}
<div class="layout-form clearfix">
	<div class="layout-region layout-region--main">
		<div class="layout-region__content">
    {% block main %}
      {{ form|without('advanced', 'footer', 'actions') }}
    {% endblock %}
    </div>
  </div>
  <div class="layout-region layout-region--secondary">
    <div class="layout-region__content">
    {% block secondary %}
      {{ form.advanced }}
    {% endblock %}
    </div>
  </div>
  <div class="layout-region layout-region--footer">
    <div class="layout-region__content">
    {% block footer %}
      {{ form.footer }}
      {{ form.actions }}
    {% endblock %}
    </div>
  </div>
</div>
