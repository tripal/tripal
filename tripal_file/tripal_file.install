        'not null' => FALSE
      ],
      'filename' => [
        'type' => 'text',
        'not null' => FALSE,
        'description' => t('The short name of the uri as displayed to the user.'),
      ],
    ],
    'primary key' => ['fileloc_id'],
    'unique keys' => [
      'fileloc_c1' => ['file_id', 'uri'],
    ],
    'indexes' => [
      'fileloc_idx1' => ['file_id'],
    ],
    'foreign keys' => [
      'file' => [
        'table' => 'file',
        'columns' => [
          'file_id' => 'file_id',
        ],
      ],
    ],
  ];
  chado_create_custom_table('fileloc', $schema, TRUE, NULL, FALSE);
}

