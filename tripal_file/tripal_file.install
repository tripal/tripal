  $mapping->refreshMapping('config/install/tripal_chado.chado_term_mapping.core_mapping');
print "CP74 tripal_file_add_linker_table_terms\n";//@@@
return;

#  the chado_semweb table is not currently in tripal
#@todo      $storage = \Drupal::entityTypeManager()->getStorage('chado_term_mapping');
#      self::$mapping = $storage->load('core_mapping');
# maybe tripal_chado_rebuild_chado_term_mappings();
  // Terms for linker tables
  $linked_tables = tripal_file_get_linked_tables();

  foreach ($linked_tables as $linked_table) {
