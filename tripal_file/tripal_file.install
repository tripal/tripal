<?php

use Symfony\Component\Yaml\Yaml;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Messenger\Messenger;
use Drupal\tripal_chado\ChadoCustomTables\ChadoCustomTable;
use Drupal\tripal_chado\Database\ChadoSchema;
use Drupal\tripal_chado\Entity\ChadoTermMapping;
use Drupal\tripal_chado\Services\ChadoTermsInit;

/**
 * @file
 *
 * Installation of the Tripal File module
 */

/**
 * Implements hook_requirements().
 *
 * This hook does not support attributes and must remain procedural.
 */
function tripal_file_requirements($phase) {
  $requirements = [];
  if ($phase == 'install') {
    if (version_compare(\Drupal::VERSION, 10.4) < 0) {
      $requirements['tripal_file'] = [
        'title' => 'tripal_file',
        'value' => 'ERROR: You must have Drupal version 10.4 or higher installed to use this module.',
        'severity' => REQUIREMENT_ERROR,
      ];
    }
  }
  return $requirements;
}

/**
 * Implements hook_install().
 *
 * Performs actions when the modules is first installed.
 *
 * @ingroup tripal_file
 */
function tripal_file_install() {
  $chado = \Drupal::service('tripal_chado.database');

  // Create tripal terms for the new CV terms defined in YAML files.
  tripal_file_show_message('Adding new vocabulary terms');
  tripal_file_create_tripal_terms();

  // Add the custom tables needed to associate Chado content with files.
  tripal_file_show_message('Adding custom tables');
  \Drupal::service('tripal_file.rebuild_service')->createCustomChadoTables();

  // Associate terms with the linker tables.
  tripal_file_show_message('Adding linker table terms');
  tripal_file_add_linker_table_terms();

  // Import new content types defined in YAML for this module.
  tripal_file_show_message('Creating new content types: file, license');
  tripal_file_import_content_types();

  // Insert standard license types.
  tripal_file_show_message('Adding and publishing standard license types');
  tripal_file_add_default_licenses($chado);

  // Install the full EDAM ontology.
  tripal_file_show_message('Installing the EDAM ontology');
  tripal_file_load_EDAM_obo();
}

/**
 * Implements hook_uninstall().
 *
 * The hook uninstall does not support attributes and must remain procedural.
 */
function tripal_file_uninstall() {
  // Delete the custom tables created by this module.
  \Drupal::service('tripal_file.hooks')->tripalFileUninstall();
}

/**
 * Displays a status message.
 *
 * This handles displaying both to the UI and to drush output.
 *
 * @param string $message
 *   The message to be displayed.
 */
function tripal_file_show_message(string $message) {
  // This is displayed when this module is installed with the UI.
  \Drupal::messenger()->addStatus($message);
  // This is displayed when this module is installed with drush.
  \Drupal::logger('tripal_file')->notice($message);
}

/**
 * Creates tripal terms for newly added CV terms for content types.
 *
 * The new CV terms are defined in YAML in /config/install/
 * tripal.tripal_content_terms.tripal_file_content_terms.yml
 * and files located there are added automatically by Drupal,
 * so here we just need to install them.
 *
 * @return void
 *   No return value.
 */
function tripal_file_create_tripal_terms(): void {
  $terms_init_service = \Drupal::service('tripal_chado.terms_init');
  $terms_init_service->installTerms('tripal_file_content_terms');
}

/**
 * Adds the vocabulary terms for the linker table columns.
 *
 * @return void
 *   No return value.
 */
function tripal_file_add_linker_table_terms(): void {
  $storage_id = 'chado_term_mapping';
  $core_config_id = 'core_mapping';
  $tripal_file_config_id = 'tripal_file_mapping';
  /** @var Drupal\Core\Config\Entity\ConfigEntityStorage $storage */
  $storage = \Drupal::entityTypeManager()->getStorage($storage_id);
  /** @var Drupal\tripal_chado\Entity\ChadoTermMapping $chado_core_mapping */
  $chado_core_mapping = $storage->load($core_config_id);
  $core_mapping_tables = $chado_core_mapping->get('tables');

  // Get a keyed list to be able to determine if a table is already present.
  $existing_tables = [];
  foreach ($core_mapping_tables as $table) {
    $existing_tables[$table['name']] = TRUE;
  }

  // Get the table mapping for this module.
  $tripal_file_mapping = $storage->load($tripal_file_config_id);
  $tripal_file_tables = $tripal_file_mapping->get('tables');

  // Add table mappings from this module to core mapping.
  $updated = FALSE;
  foreach ($tripal_file_tables as $table) {
    if (!isset($existing_tables[$table['name']])) {
      $core_mapping_tables[] = $table;
      $updated = TRUE;
    }
  }
  if ($updated) {
    $chado_core_mapping->set('tables', $core_mapping_tables);
    $chado_core_mapping->save();
  }
}

/**
 * Creates content types and fields used by this module.
 *
 * The two new content types will be file and license, which
 * are in the "tripal_file" collection defined by this module.
 *
 * @return void
 *   No return value.
 */
function tripal_file_import_content_types(): void {

  // Import the content type collection.
  $content_type_service = \Drupal::service('tripal.tripalentitytype_collection');
  $content_type_service->install(['tripal_file']);

  // Import the fields on the new content types.
  $fields_service = \Drupal::service('tripal.tripalfield_collection');
  $fields_service->install(['tripal_file']);
}

/**
 * Creates several standard license type records.
 *
 * @return void
 *   No return value.
 */
function tripal_file_add_default_licenses($chado): void {

  $config = __DIR__ . '/config/other/tripal_file.license_definitions.yml';
  $license_defs = Yaml::parseFile($config);

  // Add standard licenses if they do not exist.
  // If either the name or the uri exists, then skip adding.
  $n_added = 0;
  foreach ($license_defs as $license_def) {
    $query = $chado->select('1:license', 'L');
    $query->addField('L', 'license_id', 'license_id');
    $or_group = $query->orConditionGroup();
    $or_group->condition('L.name', $license_def['name'], '=');
    $or_group->condition('L.uri', $license_def['uri'], '=');
    $query->condition($or_group);
    $license_id = $query->execute()->fetchField();
    if (!$license_id) {
      $chado->insert('1:license')
        ->fields($license_def)
        ->execute();
      $n_added++;
    }
  }

  // Publish the new licenses.
  if ($n_added) {
    $tripal_publish_service = \Drupal::service('tripal.backend_publish');
    $default_schema_name = \Drupal::config('tripal_chado.settings')->get('default_schema');
    $chado_publish_instance = $tripal_publish_service->createInstance('chado_storage', []);
    $publish_options = [
      'bundle' => 'tripal_license',
      'datastore' => 'chado_storage',
      'schema_name' => $default_schema_name,
    ];
    $published_entities = $chado_publish_instance->publish($publish_options);
  }
}

/**
 * Installs the EDAM ontology.
 */
function tripal_file_load_EDAM_obo() {
  $public = \Drupal::database();

  // If not already present, insert a record into the
  // "tripal_cv_obo" table defining the vocabulary to load.
  $query = $public->select('tripal_cv_obo', 'O');
  $query->condition('O.name', 'EDAM', '=');
  $query->addField('O', 'obo_id', 'obo_id');
  $results = $query->execute()->fetchAll();
  $obo_id = 0;
  if (count($results) > 0) {
    $obo_id = $results[0]->obo_id;
  }
  if (!$obo_id) {
    $insert = $public->insert('tripal_cv_obo');
    $insert->fields([
      'name' => 'EDAM',
      'path' => 'https://edamontology.org/EDAM.obo||{tripal_file}/files/EDAM.obo',
    ]);
    $obo_id = $insert->execute();
  }

  $importer_manager = \Drupal::service('tripal.importer');
  $obo_importer = $importer_manager->createInstance('chado_obo_loader');
  $default_schema_name = \Drupal::config('tripal_chado.settings')->get('default_schema');
  $obo_importer->createImportJob([
    'obo_id' => $obo_id,
    'schema_name' => $default_schema_name,
  ]);

  // This fixes migrated Tripal 3 EDAM terms with db of 'HTTP:'.
  \Drupal::service('tripal_file.rebuild_service')->applyPr2280Fix();

  // Submit the import job. This takes enough time that it needs to be
  // detached from the install as a separate job so that there is no
  // chance of causing a page timeout.
  // If we detect that module install is being run from drush rather
  // than from the UI, we can execute immediately rather than submit
  // a job.
  $from_drush = function_exists('drush_main');
  if ($from_drush) {
    $obo_importer->run();
    $obo_importer->postRun();
  }
  else {
    $obo_importer->submitJob();
  }
}
