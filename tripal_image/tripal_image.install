  // Add the custom tables needed to associate Chado content with images.
  tripal_image_show_message('Adding custom tables');
  \Drupal::service('tripal_image.rebuild_service')->createCustomChadoTables();

  // Associate terms with the linker tables.
  tripal_image_show_message('Adding linker table terms');
