tripal_chado/tests/fixtures/fill_chado_test_prepare.sql:4178:INSERT INTO chado.cvterm VALUES (518, 23, 'PAC', 'The P1-derived artificial chromosome are DNA constructs that are derived from the DNA of P1 bacteriophage. They can carry large amounts (about 100-300 kilobases) of other sequences for a variety of bioengineering purposes. It is one type of vector used to clone DNA fragments (100- to 300-kb insert size; average, 150 kb) in Escherichia coli cells. [http://en.wikipedia.org/wiki/P1-derived_artificial_chromosome]', 519, 0, 0);
