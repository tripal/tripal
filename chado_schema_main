tripal_chado/tests/fixtures/fill_chado_test_prepare.sql:4411:INSERT INTO chado.cvterm VALUES (750, 23, 'nucleic_acid', 'An attribute describing a sequence consisting of nucleobases bound to repeating units. The forms found in nature are deoxyribonucleic acid (DNA), where the repeating units are 2-deoxy-D-ribose rings connected to a phosphate backbone, and ribonucleic acid (RNA), where the repeating units are D-ribose rings connected to a phosphate backbone. [CHEBI:33696, RSC:cb]', 755, 0, 0);
