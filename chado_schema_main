tripal_chado/tests/fixtures/fill_chado_test_prepare.sql:4205:INSERT INTO chado.cvterm VALUES (545, 23, 'TATA_box', 'A conserved AT-rich septamer found about 25-bp before the start point of many eukaryotic RNA polymerase II transcript units; may be involved in positioning the enzyme for correct initiation; consensus=TATA(A|T)A(A|T). [http://www.insdc.org/files/feature_table.html, PMID:16858867]', 548, 0, 0);
