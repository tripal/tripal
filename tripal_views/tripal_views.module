<?php

/**
 * @file
 * Contains tripal_views.module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 *
 * This legacy hook is only run for Drupal < 11, and is replaced by class
 * Drupal\tripal_views\Hook\TripalViewsHooks in
 * tripal_views/src/Hook/TripalViewsHooks.php.
 */
#[LegacyHook]
function tripal_views_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service('tripal_views.hooks')->help($route_name, $route_match);
}
