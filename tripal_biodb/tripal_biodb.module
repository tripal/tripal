<?php

use Drupal\Core\Hook\Attribute\LegacyHook;

/**
 * @file
 * Contains tripal_biodb.module.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 *
 * This legacy hook is only run for Drupal < 11, and is replaced by class
 * Drupal\tripal_biodb\Hook\TripalBiodbHooks in
 * tripal_biodb/src/Hook/TripalBiodbHooks.php.
 */
#[LegacyHook]
function tripal_biodb_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service('tripal_biodb.hooks')->help($route_name, $route_match);
}
